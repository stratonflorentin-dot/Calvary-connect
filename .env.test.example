# Copy to .env.test.local (gitignored) and fill in with the values
# `supabase start` prints once Docker is running and the local stack is up:
#
#   npx supabase start
#
# That command prints an API URL, anon key, and service_role key — paste
# them below. These are LOCAL-ONLY values (default local JWT secret),
# never the same as the production project's keys, and safe to keep in
# a local, gitignored file.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

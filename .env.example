# Supabase Environment Variables
# Copy this file to .env.local and fill in your actual Supabase credentials

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# AI providers (server-only API keys; either key works, both enable failover)
OPENROUTER_API_KEY=
GROQ_API_KEY=
# Optional preference: openrouter or groq
AI_PROVIDER=openrouter

# Generate a high-entropy secret before enabling scheduled external health checks.
# Configure the same value in the Next.js deployment and Supabase Function secrets.
EXTERNAL_HEALTH_CHECK_SECRET=

# ElevenLabs (AI voice playback for the Calvary AI Analyst — voice "Mino")
# Get a key at https://elevenlabs.io (free tier works for testing)
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
